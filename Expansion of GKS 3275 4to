                                <msItem n="5" class="log">
                                    <locus from="449r" facs="#GKS04-3275-0449r" to="466v">449r-466v</locus>
                                <title type="supplied">Hjúskaparlög Friðriks II. 1587</title>
                                <rubric>hjónabands articular, útgefnir af kóng Friðrik.</rubric>
                                <msItem n="5.1">
                                    <locus from="449r" facs="#GKS04-3275-0449r" to="450r">449r-450r</locus>
                                    <title type="supplied">Friðrik sér með Guðs náð</title>
                                    <rubric>Sér Friðrik sá annar þess nafns með Guðs náð</rubric>
                                    <incipit>Danmerkur, Noregs, Vinda og Göta kóngur…</incipit>
                                    <explicit>...svo eru látandi orð eftir sem hér eftirfilgir.</explicit>
                                </msItem>
                                <msItem n="5.2">
                                    <locus from="450r" facs="#GKS04-3275-0450r" to="452r">449r-452r</locus>
                                    <title type="supplied">Um erulofunina</title>
                                    <rubric>Um erulofunena</rubric>
                                    <incipit>Eptir því að hjónabandið er í fyrstu innsett…</incipit>
                                    <explicit>...því máli sem fyrr er sagt um þann sem vill gera forboð, eða hindrum á hjónabandinu.</explicit>
                                </msItem>
                                <msItem n="5.3">
                                    <locus from="452r" facs="#GKS04-3275-0452r" to="453v">452r-453v</locus>
                                    <title type="supplied">Um trúlofunina</title>
                                    <rubric>Svo skal nú haldast um trúlofunina eptir orðinantíunni</rubric>
                                    <incipit>Fyrst að öngver skulu trúlofast til samans…</incipit>
                                    <explicit>...svá eru látandi orð eftir sem hér eftirfilgni.</explicit>
                                </msItem>
                                <msItem n="5.4">
                                    <locus from="453r" facs="#GKS04-3275-0453r" to="456v">453v-456v</locus>
                                    <title type="supplied">Hvar fyrir þau sem trúlofað hafa verið mega aðskiljast</title>
                                    <rubric>Nokkrar sérlegar sakir hvar fyrir þau sem trúlofuð hafa verið saman mega aðskiljast.</rubric>
                                    <incipit>Þá trúlofan til hvárrar nokkrum hefur nöðgað verið…</incipit>
                                    <explicit>...en hvort þeirra þekkir annað vel.</explicit>
                                </msItem>
                                <msItem n="5.5">
                                    <locus from="456v" facs="#GKS04-3275-0456v" to="458r">456v-458r</locus>
                                    <title type="supplied">Um jómfrú krenkjara</title>
                                    <rubric>Um jómfrú krenkjara</rubric>
                                    <incipit>Hvað sem jómfrú krenking á grærir þar um…</incipit>
                                    <explicit>...honum ber eftir guðs og nállurunnar logum, að straffast á lýstinu.</explicit>
                                </msItem>
                                <msItem n="5.6">
                                    <locus from="458r" facs="#GKS04-3275-0458r" to="459v">458r-459v</locus>
                                    <title type="supplied">Sakirnar að skiljast</title>
                                    <rubric>Sakirnar fyrir hverjar ekta hjónin mega að skiljast</rubric>
                                    <incipit>Sú fyrsta sók er hórðómur, þó skal sú persónan sem á klagar stefna þeim löglega…</incipit>
                                    <explicit>...svá eru látandi orð eptir sem hér eptirfilgir.</explicit>
                                </msItem>
                                <msItem n="5.7">
                                    <locus from="459v" facs="#GKS04-3275-0459v" to="461v">459v-461v</locus>
                                    <title type="supplied">Hvar að skiljast</title>
                                    <rubric>En önnur orð sök, hvar fyrir hjónin mega skiljast</rubric>
                                    <incipit>Ór Desertio, nar annað hvort hjóna yfirgefur annað…</incipit>
                                    <explicit>...og samlagast aftur sínum fyrra eiginmanni.</explicit>
                                </msItem>
                                <msItem n="5.8">
                                    <locus from="461v" facs="#GKS04-3275-0461v" to="462r">461v-462r</locus>
                                    <title type="supplied">Sú þriðja sök að skiljast</title>
                                    <rubric>Sú þriðja sök hvar fyrir hjónin mega skilja er.</rubric>
                                    <incipit>Ór ef nokkur er, impotens, það er óskikkanlegur til hjónabandsins…</incipit>
                                    <explicit>...þá skulu þau umbera það sem annan kross og mótgang sem í hjónabandinu kann til að falla..</explicit>
                                </msItem>
                                <msItem n="5.9">
                                    <locus from="462r" facs="#GKS04-3275-0462r" to="462r">462r-462r</locus>
                                    <title type="supplied">Um aðskiljanleg</title>
                                    <rubric>Um aðskiljanleg til felli í hjónabandinn</rubric>
                                    <incipit>Ef maður eða kunna sem að er eigingipt…</incipit>
                                    <explicit>...sétit á óru slofi kronborg, þann annan dag Júní. Anno 1587 undir vort signet Friðrik.</explicit>
                                </msItem>
                                </msItem>
                                <msItem n="6" class="log">
                                    <locus from="469r" facs="#GKS04-3275-0469r" to="493r">469r-493r</locus>
                                <title type="supplied">Réttarbætur</title>
                                <rubric>Hér eftir fylgja nokkrar Réttarbætur</rubric>
                                <msItem n="6.1">
                                    <locus from="469r" facs="#GKS04-3275-0469r" to="471r">469r-471r</locus>
                                    <title type="supplied">Réttarbót Hákonar konungs</title>
                                    <incipit>Hákon með guðs miskunn Noregs og Svía kóngur…</incipit>
                                    <explicit>...á XX ári ríkis vors Noregs, og innsiglað oss sjálfum hjá verundum.</explicit>
                                </msItem>
                                <msItem n="6.2">
                                    <locus from="471r" facs="#GKS04-3275-0471r" to="472r">471r-472r</locus>
                                    <title type="supplied">Hákonar bréf</title>
                                    <incipit>hákon með guðs miskunn Noregs kóngur, etc. Héðan of skulu karlmenn nefnast til eið vattis…</incipit>
                                    <explicit>...á XIV ári ríkis vors herra Bjarni Auðunarson innsiglaði oss sjálfum hjá verundum, Þorgeir Torfason ritaði.</explicit>
                                </msItem>
                                <msItem n="6.3">
                                    <locus from="472r" facs="#GKS04-3275-0472r" to="473r">472r-473r</locus>
                                    <title type="supplied">...</title>
                                    <rubric>Um Bréfabrot kóngs</rubric>
                                    <incipit>Hákon með guðs miskunn Noregs kóngur sendir H. lögmanni etc…</incipit>
                                    <explicit>...þá viljum vér að fari eftir því sem lögbók vottar. Etc.</explicit>
                                </msItem>
                                <msItem n="6.4">
                                    <locus from="473r" facs="#GKS04-3275-0473r" to="474v">473r-474v</locus>
                                    <title type="supplied">Herjólfs Barnamál og arftaka</title>
                                    <rubric>Herjólfs Barnamál og arftaka</rubric>
                                    <incipit>Hákon með guðs miskunn Noregs kóngur, etc. Vér viljum yður kunnigt gjöra…</incipit>
                                    <explicit>...og öðrum börnum Meistara Herjólfs löglega arfleiddum, arf frú Ragnhildar föður móður sinnar.</explicit>
                                </msItem>
                                <msItem n="6.5">
                                    <locus from="474v" facs="#GKS04-3275-0474v" to="476r">474v-476r</locus>
                                    <title type="supplied">Hákonar Félag</title>
                                    <rubric>Félag</rubric>
                                    <incipit>Hákon með guðs miskunn, etc. Vér höfum oftlega beðnir verit um félags gjörð þá sem stendur í lögbók…</incipit>
                                    <explicit>...þá skiptist eftir jarðar eignum sú landskíld sem öneitts er sem tala rennur til.</explicit>
                                </msItem>
                                <msItem n="6.6">
                                    <locus from="476r" facs="#GKS04-3275-0476r" to="476v">476r-476v</locus>
                                    <title type="supplied">Annað Hákonar Bréf</title>
                                    <incipit>Hákon með guðs miskunn Noregs kóngur, etc. þar sem menn sækja fjárloknir sínar í héröðum með at farar þingi…</incipit>
                                    <explicit>bjóðum vér sýslumönnum og lögmönnum að leggja svo hvers manns mál sem bréf þeirra vottas.</explicit>
                                </msItem>
                                <msItem n="6.7">
                                    <locus from="476v" facs="#GKS04-3275-0476v" to="478v">476v-478v</locus>
                                    <title type="supplied">Réttarbót Eiríks konungs</title>
                                    <incipit>Svo skipaði virðuglegur herra Eiríkur kóngur son Magnús kongs að hvervefna þar sem sakar beri stefnir undir rétt próf til sýslumanns og kemur hann ei forfallalaust…</incipit>
                                    <explicit>...að faðir hans verði ílendur síðan.</explicit>
                                </msItem>
                                <msItem n="6.8">
                                    <locus from="478v" facs="#GKS04-3275-0478v" to="482r">478v-482r</locus>
                                    <title type="supplied">Réttarbót Eiríks konungs</title>
                                    <incipit>Eiríku með guðs miskunn Noregs kóngur hinn kórónaði, etc…</incipit>
                                    <explicit>...ef hann hefur uppi halðit á buð eftir lögum.</explicit>
                                </msItem>
                                <msItem n="6.9">
                                    <locus from="482v" facs="#GKS04-3275-0482v" to="483v">482v-483v</locus>
                                    <title type="supplied">Þriðja Hákonar bréf</title>
                                    <incipit>Hákon með guðs miskunn Noregs kóngur, etc …</incipit>
                                    <explicit>... á annan dag lofa á XI ári ríkis vors etc.</explicit>
                                </msItem>
                                <msItem n="6.10">
                                    <locus from="483v" facs="#GKS04-3275-0483v" to="485v">483v-485v</locus>
                                    <title type="supplied">...</title>
                                    <incipit>Hákon með guðs miskunn Noregs kóngur, etc. það er oftlega kjart fyrir oss…</incipit>
                                    <explicit>...á IV ári ríkis vors herra hákonar. Tanseler vor inciglaði. Páll klerkur ritaði.</explicit>
                                </msItem>
                                <msItem n="6.11">
                                    <locus from="485v" facs="#GKS04-3275-0485v" to="486v">485v-486v</locus>
                                    <title type="supplied">Réttarbót Magnúsar konungs</title>
                                    <incipit>Þessar réttarbætur gaf Magnús kóngur að þótt…</incipit>
                                    <explicit>...þó að fé sé ei meira en þeim vinst til forlagseyris.</explicit>
                                </msItem>
                                <msItem n="6.12">
                                    <locus from="487r" facs="#GKS04-3275-0487r" to="488v">487r-488v</locus>
                                    <title type="supplied">Magnúsar bréf</title>
                                    <incipit>Magnús með guðs miskunn Noregs kóngur, etc. Vér viljum að þér vitið…</incipit>
                                    <explicit>...á IV <c>&amp;</c> XX ári ríkis vors kanseler vor innsiglaði oss sjálfum hjá verundum, Helgi Tvarson ritaði.</explicit>
                                </msItem>
                                <msItem n="6.13">
                                    <locus from="488v" facs="#GKS04-3275-0488v" to="489r">488v-489r</locus>
                                    <title type="supplied">...</title>
                                    <rubric>Um kaup á vöru.</rubric>
                                    <incipit>Svo er skipat og staðfest að kóngur og hans umboðs maður á fyrst kaup…</incipit>
                                    <explicit>...En öfundar böl fyrir mini fjárskaða eftir atvikum í eða sýnjelyritlar eiði. Datum etc.</explicit>
                                </msItem>
                                <msItem n="6.14">
                                    <locus from="489rv" facs="#GKS04-3275-0489r" to="492v">489r-492v</locus>
                                    <title type="supplied">Gamli sáttmáli</title>
                                    <rubric>Gamli sáttmáli á millum Noregs kóngs og Íslendinga.</rubric>
                                    <incipit>Í nafni föður og sonar og anda heilags…</incipit>
                                    <explicit>...þá sekist sá IV morkum við kóng svo sem hann rjúfi lögmanns úrskurð.</explicit>
                                </msItem>
                                <msItem n="6.15">
