                                		<locus from="2r" facs="#GKS04-3275-0002r" to="5r">2r-5r</locus>
                                		<title type="supplied">Magnús bréfs</title>
                                		<rubric>hér byrjar Magnús bréfs</rubric>
                                		<incipit>Magnús með Guðs miskunn Noregskóngur…</incipit>
                                		<explicit>... hans nafn sé blessað utan enda. Amen</explicit>
                                	</msItem>
                                	<msItem n="1.2">
                                		<locus from="5v" facs="#GKS04-3275-0005v" to="19r">5v-19r</locus>
                                		<title type="supplied">Þingfararbálkur</title>
                                		<rubric>Þingfararbálkur</rubric>
                                		<incipit>Friður og blessun vors Guðs almáttugs föður…</incipit>
                                		<explicit>...ef skinsömum mönnum sýnisk þeir fæ ýfirtekið</explicit>
                                	</msItem>
                                	<msItem n="1.3">
                                		<locus from="19r" facs="#GKS04-3275-0019r" to="31v">19r-31v</locus>
                                		<title type="supplied">Kristindómsbálkur</title>
                                		<rubric>Hér hefur upp Kristindóms bálk</rubric>
                                		<incipit>Það er upphaf laga vorra Íslendinga…</incipit>
                                		<explicit>... og fylgi honum allir hinir bestu menn.</explicit>
                                	</msItem>
                                	<msItem n="1.4">
                                		<locus from="31v" facs="#GKS04-3275-0031v" to="35v">31v-35v</locus>
                                		<title type="supplied">Konungs þegnskylda</title>
                                		<rubric>um Þegnskyldu við kóng og skattgjald</rubric>
                                		<incipit>Í nafni vors herra Iesú Kristí…</incipit>
                                		<explicit>... en hálft þeim er skuld á.</explicit>
                                	</msItem>
                                	<msItem n="1.5">
                                		<locus from="35v" facs="#GKS04-3275-0035v" to="74r">35v-74r</locus>
                                		<title type="supplied">Mannhelgi</title>
                                		<rubric>Hér hefur mannhelgi</rubric>
                                		<incipit>Það er fyrst í Mannhelgi vorri að…</incipit>
                                		<explicit>... en öngu á hann að svara þar sem hann erfir ekki.</explicit>
                                	</msItem>
                                	<msItem n="1.6">
                                		<locus from="74r" facs="#GKS04-3275-0074r" to="83v">74r-83v</locus>
                                		<title type="supplied">Kvennagiftingar</title>
                                		<rubric>Hér hefur hinn fjórða hlut lögbókar sem er um kvennagiftingar</rubric>
                                		<incipit>Faðir og móðir skulu ráða giftingum dætra sinna…</incipit>
                                		<explicit>... því að enginn skal sér konu kaupa með annars fé.</explicit>
                                	</msItem>
                                	<msItem n="1.7">
                                		<locus from="83v" facs="#GKS04-3275-0083v" to="109r">83v-109r</locus>
                                		<title type="supplied">Erfðatal</title>
                                		<rubric>Hér hefur Almennilegt Erfðatal</rubric>
                                		<incipit>Sú er hin fyrsta erfð er …</incipit>
                                		<explicit>... fyrir sál sinni, hverjum manni sem hann gefur löggjöf sína fyrr.</explicit>
                                	</msItem>
                                	<msItem n="1.8">
                                		<locus from="109r" facs="#GKS04-3275-0109r" to="125v">109r-125v</locus>
                                		<title type="supplied">Framfærslubálkur</title>
                                		<rubric>Hér hefur framfærslubálk</rubric>
                                		<incipit>Hver maður á fram að færa …</incipit>
                                		<explicit>... utan honum sé gefin, nema konur beri.</explicit>
                                	</msItem>
                                	<msItem n="1.9">
                                		<locus from="125v" facs="#GKS04-3275-0125v" to="139r">125v-139r</locus>
                                		<title type="supplied">Landabrigðabálkur</title>
                                		<rubric>Hér hefur hinn fimmta hlut lögbókar sem er landabrigði</rubric>
                                		<incipit>Hvar sem ungum manni tæmist land í erfð …</incipit>
                                		<explicit>... er ómagann skyldi fram hafa fært.</explicit>
                                	</msItem>
                                	<msItem n="1.10">
                                		<locus from="139r" facs="#GKS04-3275-0139r" to="204v">139r-204v</locus>
                                		<title type="supplied">Landsleigubálkur</title>
                                		<rubric>Hér hefur landsleigu bálk</rubric>
                                		<incipit>Ef maður vill annars jörð leigja…</incipit>
                                		<explicit>... og rétt sinn á ofan eftir lágadómi.</explicit>
                                	</msItem>
                                	<msItem n="1.11">
                                		<locus from="205r" facs="#GKS04-3275-0205v" to="216r">205r-216r</locus>
                                		<title type="supplied">Rekabálkur</title>
                                		<rubric>Hér hefur Rekabálk</rubric>
                                		<incipit>Hver maður á reka allan fyrir landi sínu…</incipit>
                                		<explicit>... ef það sé er svo mikið, að þjófsök nemur</explicit>
                                	</msItem>
                                	<msItem n="1.12">
                                		<locus from="216r" facs="#GKS04-3275-0216r" to="236r">216r-236r</locus>
                                		<title type="supplied">Kaupabálkur</title>
                                		<rubric>Kaupabálkur</rubric>
                                		<incipit>Það er nú því næst að vor skal engi fyrir öðrum taka…</incipit>
                                		<explicit>... svari slíku fyrir sem hann hefði stolið jafnmiklu</explicit>
                                	</msItem>
                                	<msItem n="1.13">
                                		<locus from="236r" facs="#GKS04-3275-0236r" to="255r">236r-255r</locus>
                                		<title type="supplied">Farmannalög</title>
                                		<rubric>Farmanna Lög</rubric>
                                		<incipit>Sú er lögleg fartekja en engi önnur…</incipit>
                                		<explicit>... Eigi viljum vér að mikil skreið flitést héðan af landinu meðan hallæri er</explicit>
                                	</msItem>
                                	<msItem n="1.14">
                                		<locus from="255v" facs="#GKS04-3275-0255v" to="269r">255v-269r</locus>
                                		<title type="supplied">Þjófabálkur</title>
                                		<rubric>og kallaði þjófa bálkur</rubric>
                                		<incipit>Það er nú því næst að vor skal engi annan stela…</incipit>
                                		<explicit>... en virða þá til fullra aura</explicit>
                                	</msItem>
                                </msItem>
